FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 MODEL_ROOT=/app/out/models PRODUCTION=1 EVENTS_BACKEND=sqs EVENTS_DB=/tmp/eventos.db
WORKDIR /app
COPY requirements-ep2.txt .
RUN pip install --no-cache-dir -r requirements-ep2.txt && useradd --create-home --uid 10001 app
COPY src/core.py src/api.py src/cloud_ep2.py /app/src/
COPY src/static/ /app/src/static/
COPY out/models/ /app/out/models/
USER 10001
WORKDIR /app/src
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health/ready',timeout=2)"
CMD ["uvicorn","api:app","--host","0.0.0.0","--port","8000","--no-access-log"]
