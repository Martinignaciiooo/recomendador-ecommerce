# Proxy inverso con HTTPS automático (Let's Encrypt).
# bootstrap_ec2.sh reemplaza __DOMINIO__ por el dominio real.
__DOMINIO__ {
    encode gzip
    reverse_proxy 127.0.0.1:8000
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }
}
